# ---- PostgreSQL connection ---------------------------------
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="realtime_data_stream"
PGUSER="postgres"
# Leave blank only when PostgreSQL peer/trust authentication is configured.
PGPASSWORD="12345678"

# ---- Data source -------------------------------------------
# ONLINE_SALES_FILE=data/static/online.csv
ONLINE_SALES_FILE="data/static/online_sales_stream.csv"
