MD_PARTITION_SIZE=500
STREAM_CHUNK_SIZE=500
STREAM_BUFFER_LIMIT=1000
PEAK_RATE=80
NON_PEAK_RATE=10
SIMULATED_HOUR_SECONDS=60
NUM_PERIODIC_GROUPS=48

